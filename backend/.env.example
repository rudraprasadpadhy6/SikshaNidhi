# Groq API Key
# Replace this with your actual key from https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL Database URL (leave blank to use local SQLite fallback)
# Format: postgresql://user:password@host:5432/dbname
# Example: postgresql://postgres:secret@localhost:5432/sikshanidhi
DATABASE_URL=

# Admin key for the private Feedback Panel
ADMIN_FEEDBACK_KEY=siksha-admin-2026
